{
  "name": "Monitoreo de recorridos (Expo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [8081],
  "portsAttributes": { "8081": { "label": "Expo Metro", "onAutoForward": "notify" } },
  "customizations": { "vscode": { "extensions": ["expo.vscode-expo-tools"] } },
  "remoteUser": "node"
}
